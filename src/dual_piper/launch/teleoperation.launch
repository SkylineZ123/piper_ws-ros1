<launch>
  <!--
    Piper 双臂遥操作采集环境:
      2x state_get_node (发布 /left|right/{master,slave}_joint_states)
      3x realsense2_camera (发布 /cam_top|leftwrist|rightwrist/color/image_raw)

    无硬件自检: roslaunch dual_piper teleoperation.launch start_state:=false start_cameras:=false
  -->
  <arg name="start_state" default="true"/>
  <arg name="start_cameras" default="true"/>
  <arg name="can_left" default="can_left"/>
  <arg name="can_right" default="can_right"/>
  <arg name="serial_top" default="327122074756"/>
  <arg name="serial_left" default="148522072680"/>
  <arg name="serial_right" default="241222073777"/>
  <arg name="color_width" default="640"/>
  <arg name="color_height" default="480"/>
  <arg name="color_fps" default="30"/>

  <!-- 双臂状态发布 -->
  <node if="$(arg start_state)" pkg="dual_piper" type="state_get_node.py" name="state_get_left" output="screen">
    <param name="can_name" value="$(arg can_left)"/>
    <param name="side" value="left"/>
  </node>
  <node if="$(arg start_state)" pkg="dual_piper" type="state_get_node.py" name="state_get_right" output="screen">
    <param name="can_name" value="$(arg can_right)"/>
    <param name="side" value="right"/>
  </node>

  <!-- 三台 RealSense 相机: 顶部 + 左右手腕 -->
  <include if="$(arg start_cameras)" file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera" value="cam_top"/>
    <arg name="serial_no" value="$(arg serial_top)"/>
    <arg name="color_width" value="$(arg color_width)"/>
    <arg name="color_height" value="$(arg color_height)"/>
    <arg name="color_fps" value="$(arg color_fps)"/>
    <arg name="enable_depth" value="false"/>
    <arg name="enable_infra" value="false"/>
    <arg name="enable_gyro" value="false"/>
    <arg name="enable_accel" value="false"/>
    <arg name="align_depth" value="false"/>
  </include>

  <include if="$(arg start_cameras)" file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera" value="cam_leftwrist"/>
    <arg name="serial_no" value="$(arg serial_left)"/>
    <arg name="color_width" value="$(arg color_width)"/>
    <arg name="color_height" value="$(arg color_height)"/>
    <arg name="color_fps" value="$(arg color_fps)"/>
    <arg name="enable_depth" value="false"/>
    <arg name="enable_infra" value="false"/>
    <arg name="enable_gyro" value="false"/>
    <arg name="enable_accel" value="false"/>
    <arg name="align_depth" value="false"/>
  </include>

  <include if="$(arg start_cameras)" file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera" value="cam_rightwrist"/>
    <arg name="serial_no" value="$(arg serial_right)"/>
    <arg name="color_width" value="$(arg color_width)"/>
    <arg name="color_height" value="$(arg color_height)"/>
    <arg name="color_fps" value="$(arg color_fps)"/>
    <arg name="enable_depth" value="false"/>
    <arg name="enable_infra" value="false"/>
    <arg name="enable_gyro" value="false"/>
    <arg name="enable_accel" value="false"/>
    <arg name="align_depth" value="false"/>
  </include>
</launch>
