<?xml version="1.0"?>
<package format="2">
  <name>dual_piper</name>
  <version>1.0.0</version>
  <description>
    Dual-arm Piper robot teleoperation, data collection, and replay package.
    Supports HDF5 and LeRobot v3 data formats.
  </description>

  <maintainer email="wd@todo.todo">wd</maintainer>
  <license>MIT</license>

  <url type="repository">https://github.com/todo/dual_piper</url>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>piper_msgs</depend>
  <depend>cv_bridge</depend>

  <export>
  </export>
</package>
